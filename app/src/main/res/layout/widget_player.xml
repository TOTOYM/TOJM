<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
 android:layout_width="match_parent" android:layout_height="match_parent">
 <ImageView android:id="@+id/art_background" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="centerCrop" android:contentDescription="Okładka albumu"/>
 <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical"
 android:paddingLeft="16dp" android:paddingRight="16dp" android:paddingTop="13dp" android:paddingBottom="13dp">
 <LinearLayout android:layout_width="match_parent" android:layout_height="38dp" android:orientation="horizontal" android:gravity="center_vertical">
  <ImageView android:id="@+id/spotify_logo" android:layout_width="32dp" android:layout_height="32dp" android:src="@drawable/spotify_mark" android:contentDescription="Spotify"/>
  <TextView android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1"/>
  <LinearLayout android:id="@+id/route_chip" android:layout_width="wrap_content" android:layout_height="36dp" android:orientation="horizontal" android:gravity="center_vertical" android:paddingLeft="9dp" android:paddingRight="9dp" android:background="@drawable/device_chip">
   <ImageView android:layout_width="18dp" android:layout_height="18dp" android:src="@drawable/ic_headphones" android:contentDescription="Urządzenie"/>
   <TextView android:id="@+id/route_name" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginLeft="5dp"
    android:maxWidth="156dp" android:maxLines="1" android:ellipsize="end" android:text="Telefon" android:textColor="#35241B" android:textStyle="bold" android:textSize="13sp"/>
  </LinearLayout>
 </LinearLayout>
 <TextView android:layout_width="1dp" android:layout_height="0dp" android:layout_weight="1"/>
 <LinearLayout android:layout_width="match_parent" android:layout_height="70dp" android:gravity="center_vertical" android:orientation="horizontal">
  <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical" android:paddingRight="7dp">
   <TextView android:id="@+id/song" android:layout_width="match_parent" android:layout_height="wrap_content" android:maxLines="1" android:ellipsize="end" android:text="Włącz muzykę" android:textStyle="bold" android:textColor="#FFFFFFFF" android:textSize="20sp" android:shadowColor="#AA000000" android:shadowRadius="3"/>
   <TextView android:id="@+id/artist" android:layout_width="match_parent" android:layout_height="wrap_content" android:maxLines="1" android:ellipsize="end" android:text="Otwórz Spotify" android:textColor="#F0FFFFFF" android:textSize="13sp"/>
  </LinearLayout>
  <ImageView android:id="@+id/toggle" android:layout_width="62dp" android:layout_height="62dp" android:background="@drawable/toggle_button"
   android:padding="18dp" android:tint="#35241B" android:scaleType="fitCenter" android:src="@drawable/ic_play" android:contentDescription="Odtwórz lub wstrzymaj"/>
 </LinearLayout>
 <TextView android:layout_width="1dp" android:layout_height="0dp" android:layout_weight="0.35"/>
 <LinearLayout android:layout_width="match_parent" android:layout_height="40dp" android:gravity="center_vertical" android:orientation="horizontal">
  <ImageView android:id="@+id/prev" android:layout_width="38dp" android:layout_height="38dp" android:padding="7dp" android:src="@drawable/ic_prev" android:contentDescription="Poprzedni utwór"/>
  <ImageView android:id="@+id/wave_progress" android:layout_width="0dp" android:layout_weight="1" android:layout_height="29dp" android:scaleType="fitXY" android:contentDescription="Postęp odtwarzania"/>
  <ImageView android:id="@+id/next" android:layout_width="38dp" android:layout_height="38dp" android:padding="7dp" android:src="@drawable/ic_next" android:contentDescription="Następny utwór"/>
  <ImageView android:id="@+id/shuffle" android:layout_width="38dp" android:layout_height="38dp" android:padding="7dp" android:src="@drawable/ic_shuffle" android:contentDescription="Opcje losowania w Spotify"/>
  <ImageView android:id="@+id/liked" android:layout_width="38dp" android:layout_height="38dp" android:padding="7dp" android:src="@drawable/ic_liked" android:contentDescription="Polubione utwory w Spotify"/>
 </LinearLayout>
 </LinearLayout>
</FrameLayout>