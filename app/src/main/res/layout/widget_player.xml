<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:id="@+id/art_background"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="Okładka albumu"
        android:scaleType="fitXY"/>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingLeft="17dp"
        android:paddingRight="17dp"
        android:paddingTop="14dp"
        android:paddingBottom="13dp"
        android:orientation="vertical">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            <TextView
                android:id="@+id/source"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:text="●  Spotify"
                android:textColor="#FFFFFFFF"
                android:textSize="12sp"
                android:textStyle="bold"
                android:maxLines="1"
                android:ellipsize="end"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/output_pill"
                android:paddingLeft="11dp"
                android:paddingRight="11dp"
                android:paddingTop="6dp"
                android:paddingBottom="6dp"
                android:text="♫  AUDIO"
                android:textColor="#302321"
                android:textSize="10sp"
                android:textStyle="bold"/>
        </LinearLayout>
        <Space
            android:layout_width="1dp"
            android:layout_height="0dp"
            android:layout_weight="1"/>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="bottom">
            <LinearLayout
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingRight="8dp">
                <TextView
                    android:id="@+id/song"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Włącz muzykę"
                    android:textColor="#FFFFFFFF"
                    android:textSize="19sp"
                    android:textStyle="bold"
                    android:shadowColor="#A0000000"
                    android:shadowRadius="3"
                    android:shadowDy="1"
                    android:maxLines="1"
                    android:ellipsize="end"/>
                <TextView
                    android:id="@+id/artist"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Odtwórz utwór w Spotify"
                    android:textColor="#F0FFFFFF"
                    android:textSize="13sp"
                    android:maxLines="1"
                    android:ellipsize="end"/>
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="39dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">
                    <ImageView
                        android:id="@+id/prev"
                        android:layout_width="34dp"
                        android:layout_height="34dp"
                        android:padding="8dp"
                        android:contentDescription="Poprzedni utwór"
                        android:src="@drawable/ic_prev"/>
                    <ImageView
                        android:id="@+id/next"
                        android:layout_width="34dp"
                        android:layout_height="34dp"
                        android:padding="8dp"
                        android:contentDescription="Następny utwór"
                        android:src="@drawable/ic_next"/>
                </LinearLayout>
            </LinearLayout>
            <ImageView
                android:id="@+id/toggle"
                android:layout_width="68dp"
                android:layout_height="68dp"
                android:background="@drawable/toggle_button"
                android:padding="21dp"
                android:tint="#231A19"
                android:src="@drawable/ic_play"
                android:scaleType="fitCenter"
                android:contentDescription="Odtwórz lub zatrzymaj"/>
        </LinearLayout>
        <ProgressBar
            android:id="@+id/progress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="3dp"
            android:layout_marginTop="9dp"
            android:progress="0"
            android:max="1000"
            android:progressTint="#FFFFDFCB"
            android:progressBackgroundTint="#80FFDFCB"/>
    </LinearLayout>
</FrameLayout>
