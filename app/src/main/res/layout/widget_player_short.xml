    <FrameLayout android:id="@+id/wave_clip" android:layout_width="0dp" android:layout_height="24dp" android:layout_marginLeft="4dp" android:layout_gravity="left|center_vertical" android:clipChildren="true" android:visibility="gone" android:importantForAccessibility="no">
