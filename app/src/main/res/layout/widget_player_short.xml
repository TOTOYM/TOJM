  <LinearLayout android:id="@+id/compact_header" android:layout_width="match_parent" android:layout_height="24dp" android:gravity="center_vertical" android:orientation="horizontal" android:visibility="gone">
   <ImageView android:id="@+id/spotify_logo" android:layout_width="22dp" android:layout_height="22dp"
    android:src="@drawable/spotify_mark" android:contentDescription="Otwórz odtwarzacz"/>
   <TextView android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" android:importantForAccessibility="no"/>
   <LinearLayout android:id="@+id/route_chip" android:layout_width="wrap_content" android:layout_height="24dp" android:gravity="center_vertical"
    android:orientation="horizontal" android:paddingLeft="8dp" android:paddingRight="9dp" android:background="@drawable/device_chip">
    <ImageView android:id="@+id/route_icon" android:layout_width="14dp" android:layout_height="14dp" android:src="@drawable/ic_headphones" android:contentDescription="@null"/>
    <TextView android:id="@+id/route_name" android:layout_width="wrap_content" android:layout_height="wrap_content"
     android:layout_marginLeft="4dp" android:maxWidth="108dp" android:maxLines="1" android:ellipsize="end"
     android:text="Telefon" android:fontFamily="sans-serif-medium" android:textColor="#35241B" android:textSize="12sp"/>
   </LinearLayout>
  </LinearLayout>
  <TextView android:layout_width="1dp" android:layout_height="0dp" android:layout_weight="1" android:importantForAccessibility="no"/>
  <LinearLayout android:layout_width="match_parent" android:layout_height="32dp" android:gravity="center_vertical" android:orientation="horizontal">
   <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical" android:paddingRight="9dp">
    <TextView android:id="@+id/song" android:layout_width="match_parent" android:layout_height="wrap_content" android:maxLines="1" android:ellipsize="end"
     android:text="Włącz muzykę" android:fontFamily="sans-serif-medium" android:textColor="#FFFFFF" android:textSize="13sp" android:shadowColor="#80000000" android:shadowRadius="2"/>
    <TextView android:id="@+id/artist" android:layout_width="match_parent" android:layout_height="wrap_content" android:maxLines="1" android:ellipsize="end"
     android:text="Otwórz Spotify" android:textColor="#DFFFFFFF" android:textSize="11sp" android:shadowColor="#66000000" android:shadowRadius="2"/>
   </LinearLayout>
   <ImageView android:id="@+id/toggle" android:layout_width="32dp" android:layout_height="32dp"
    android:background="@drawable/toggle_button" android:padding="8dp" android:tint="#35241B" android:scaleType="fitCenter"
    android:src="@drawable/ic_play" android:contentDescription="Odtwórz"/>
  </LinearLayout>
  <TextView android:layout_width="1dp" android:layout_height="0dp" android:layout_weight="0.55" android:importantForAccessibility="no"/>
  <LinearLayout android:layout_width="match_parent" android:layout_height="24dp" android:orientation="horizontal" android:gravity="center_vertical">
   <ImageView android:id="@+id/prev" android:layout_width="30dp" android:layout_height="24dp" android:padding="6dp" android:src="@drawable/ic_prev" android:contentDescription="Poprzedni utwór"/>
