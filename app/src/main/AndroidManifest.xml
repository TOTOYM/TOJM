<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.RECORD_AUDIO"/>
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS"/>
    <queries><package android:name="com.spotify.music"/></queries>
    <application
        android:allowBackup="false"
        android:label="Muzyka Widget"
        android:icon="@drawable/ic_app"
        android:theme="@style/AppTheme"
        android:supportsRtl="true">
        <activity android:name=".MainActivity" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity android:name=".PlayerControlsActivity" android:exported="false" android:excludeFromRecents="true" />
        <receiver android:name=".MusicWidget" android:exported="false" android:label="Muzyka · 5 × 2">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_info" />
        </receiver>
        <receiver android:name=".MusicWidgetMedium" android:exported="false" android:label="Muzyka · 5 × 3">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_info_medium" />
        </receiver>
        <receiver android:name=".MusicWidgetLarge" android:exported="false" android:label="Muzyka · 5 × 4">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_info_large" />
        </receiver>
        <receiver android:name=".MusicWidgetNeon" android:exported="false" android:label="Muzyka Neon · 5 × 4">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE"/></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_info_neon"/>
        </receiver>
        <service
            android:name=".MusicListener"
            android:exported="false"
            android:label="Muzyka Widget — dostęp do multimediów"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>
    </application>
</manifest>
